      "isBanned": false
    },
    {
      "label": "Next.js should be exact version across all apps",
      "packages": ["**"],
      "dependencies": ["next"],
      "isBanned": false
    }
  ],
  "sortAz": [
    "scripts",
    "dependencies",
    "devDependencies"
  ]
}
