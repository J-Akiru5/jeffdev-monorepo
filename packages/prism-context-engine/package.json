{
  "name": "prism-context-engine",
  "version": "1.2.0",
  "description": "Prism Context Engine — Context Governance for LLMs. MCP server that gives AI coding assistants (Cursor, Claude, Windsurf, VS Code) your project's architectural rules, design system, and security constraints.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "prism": "./bin/prism.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "windsurf",
    "claude",
    "vscode",
    "ai",
    "context",
    "rules",
    "llm",
    "governance",
    "architecture",
    "coding-standards",
    "prism",
    "mcp-server"
  ],
  "author": {
    "name": "JeffDev Studio",
    "url": "https://jeffdev.studio"
  },
  "license": "MIT",
  "homepage": "https://prism.syntaxure.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/J-Akiru5/jeffdev-monorepo",
    "directory": "packages/prism-context-engine"
  },
  "bugs": {
    "url": "https://github.com/J-Akiru5/jeffdev-monorepo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
