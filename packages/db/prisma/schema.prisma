  contractTerm ContractTerm   @relation(fields: [contractTermId], references: [id], onDelete: Restrict)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([templateId])
  @@index([clientId])
  @@index([mayaSubscriptionId])
  @@map("client_contracts")
}

