// =============================================================================
// PRISM CONTEXT ENGINE (migrated from Azure Cosmos DB — MongoDB API + Gremlin)
// =============================================================================
// Source collections: projects, rules, skills, components, brands, ruleSets,
// apiKeys, subscriptions, usage, generations, videos, prism_telemetry,
// governance_memory. See PRISM_MIGRATION.md for the full migration notes,
// including two pre-existing data-shape inconsistencies fixed opportunistically
// during the port (rules.userId vs rules.createdBy; webhook_events reuse).
//
// `userId`/`createdBy`/`teamId` columns below intentionally have NO foreign-key
// relation to UserProfile. The source Cosmos collections were schemaless and at
// least one code path (MCP `list_rules`) wrote a literal "demo-user" sentinel as
// an owner id — a real FK would reject that. Keeping these as plain columns
// preserves current behavior; tightening them into relations is a follow-up.
// =============================================================================

model PrismProject {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.Text
  slug         String   @db.Text
  designSystem String   @map("design_system") @db.Text
  stack        String   @db.Text
  visibility   String   @default("private") @db.Text
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules  PrismRule[]
  skills PrismSkill[]
  videos PrismVideo[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([createdAt])
  @@map("prism_projects")
}

model PrismRule {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  name           String   @db.Text
  description    String?  @db.Text
  category       String   @default("custom") @db.Text
  content        String   @db.Text
  priority       Int      @default(50)
  tags           String[] @default([])
  pattern        String?  @db.Text
  severity       String   @default("warning") @db.Text
  source         String   @default("manual") @db.Text
  skillsContent  String?  @map("skills_content") @db.Text
  sourceRuleSet  String?  @map("source_rule_set") @db.Uuid
  originalRuleId String?  @map("original_rule_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  project        PrismProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  edgesFrom      PrismRuleEdge[]  @relation("RuleEdgeFrom")
  edgesTo        PrismRuleEdge[]  @relation("RuleEdgeTo")

  @@index([projectId])
  @@index([createdBy])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@map("prism_rules")
}

model PrismSkill {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  name        String   @db.Text
