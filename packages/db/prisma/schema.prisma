model ClientContract {
  id                 String    @id @default(uuid()) @db.Uuid
  quoteId            String?   @map("quote_id") @db.Uuid
  templateId         String    @map("template_id") @db.Uuid
  contractTermId     String    @map("contract_term_id") @db.Uuid
  clientId           String?   @map("client_id") @db.Uuid
  status             String    @default("pending") @db.Text
  startDate          DateTime? @map("start_date") @db.Timestamptz()
  endDate            DateTime? @map("end_date") @db.Timestamptz()
  mayaSubscriptionId String?   @map("maya_subscription_id") @db.Text
  mayaCheckoutId     String?   @map("maya_checkout_id") @db.Text
  mayaCustomerId     String?   @map("maya_customer_id") @db.Text
  billingCycle       String    @db.Text @map("billing_cycle")
  amount             Decimal   @db.Decimal
  currency           String    @default("PHP") @db.Text
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
