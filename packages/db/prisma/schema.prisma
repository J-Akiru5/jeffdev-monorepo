/// Prism SaaS billing state, distinct from the agency `Subscription` model
/// (PayPal/Maya client contracts) — different business domain, same provider.
model PrismSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  tier                 String    @default("free") @db.Text
  status               String    @default("active") @db.Text
  paypalSubscriptionId String?   @map("paypal_subscription_id") @db.Text
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz()
  modifiedBy           String?   @map("modified_by") @db.Uuid
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@map("prism_subscriptions")
}

model PrismUsage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// YYYY-MM
  month             String   @db.Text
  aiGenerations     Int      @default(0) @map("ai_generations")
  rulesCreated      Int      @default(0) @map("rules_created")
  componentsCreated Int      @default(0) @map("components_created")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([userId, month])
  @@map("prism_usage")
}

model PrismGeneration {
  /// App-generated id (`gen_<hex>`), preserved from the Cosmos-era format.
  id        String   @id @db.Text
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("component") @db.Text
  prompt    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, createdAt])
  @@map("prism_generations")
}

/// Video transcripts. `embedding` is a pgvector column (1536-dim, text-embedding-3-small)
/// — declared Unsupported here because Prisma Client can't type pgvector natively;
/// see packages/db/src/prism/vector-search.ts for the $queryRaw helpers that use it.
model PrismVideo {
  id         String                 @id @default(uuid()) @db.Uuid
  projectId  String                 @map("project_id") @db.Uuid
  userId     String?                @map("user_id") @db.Uuid
  title      String                 @db.Text
  status     String                 @default("pending") @db.Text
  duration   Int?
  transcript String?                       @db.Text
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime               @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  project PrismProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("prism_videos")
}

model PrismTelemetry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  toolName       String   @map("tool_name") @db.Text
  tokenCount     Int      @default(0) @map("token_count")
  byteSize       Int      @default(0) @map("byte_size")
  isError        Boolean  @default(false) @map("is_error")
  cacheHit       Boolean  @default(false) @map("cache_hit")
  fromCache      Boolean  @default(false) @map("from_cache")
  clientPlatform String?  @map("client_platform") @db.Text
  /// Not a FK / not @db.Uuid on purpose — telemetry is best-effort logging
  /// and callers may send an arbitrary id string; strict typing here would
  /// turn a logging call into a hard failure.
  projectId      String?  @map("project_id") @db.Text
  model          String?  @db.Text
  timestamp      DateTime @default(now()) @db.Timestamptz()
  ingestedAt     DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@index([userId, timestamp])
  @@index([toolName])
  @@index([projectId])
  @@map("prism_telemetry")
}

model PrismGovernanceMemory {
  id         String    @id @default(uuid()) @db.Uuid
  type       String    @db.Text
  scope      String    @db.Text
  /// Not @db.Uuid on purpose — see PrismTelemetry.projectId.
  projectId  String?   @map("project_id") @db.Text
  teamId     String?   @map("team_id") @db.Text
  content    String    @db.Text
  tags       String[]  @default([])
  importance String    @default("medium") @db.Text
  source     String    @db.Text
  sessionId  String?   @map("session_id") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  metadata   Json?

  @@index([projectId])
  @@index([teamId])
  @@index([type])
  @@index([expiresAt])
  @@map("prism_governance_memory")
}

/// Replaces the Cosmos Gremlin graph's `relates_to` / `conflicts_with` edges.
/// Tag-overlap boosting no longer needs a graph traversal — it's a plain
/// array-overlap query against PrismRule.tags (see prism/rule-graph.ts).
model PrismRuleEdge {
  id        String   @id @default(uuid()) @db.Uuid
  fromRuleId String  @map("from_rule_id") @db.Uuid
  toRuleId   String  @map("to_rule_id") @db.Uuid
  edgeType   String  @map("edge_type") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  fromRule PrismRule @relation("RuleEdgeFrom", fields: [fromRuleId], references: [id], onDelete: Cascade)
  toRule   PrismRule @relation("RuleEdgeTo", fields: [toRuleId], references: [id], onDelete: Cascade)

  @@unique([fromRuleId, toRuleId, edgeType])
  @@index([fromRuleId])
  @@index([toRuleId])
  @@map("prism_rule_edges")
}
