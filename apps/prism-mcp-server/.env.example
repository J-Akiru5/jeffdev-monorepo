# ============================================================
# Prism MCP Server — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.

# Database
MONGODB_URI=mongodb://localhost:27017
COSMOS_DATABASE_NAME=prism

# API key for subscription-based access (optional for local dev)
PRISM_API_KEY=
PRISM_API_URL=http://localhost:3001

# Azure OpenAI (for transcript embeddings)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
