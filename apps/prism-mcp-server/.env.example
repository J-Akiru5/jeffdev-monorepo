# ============================================================
# Prism MCP Server — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# These are injected via the IDE's MCP config (mcp.json) or loaded from .env.

# ---------------------------------------------------------------------------
# DATABASE (Azure Cosmos DB / MongoDB API)
# ---------------------------------------------------------------------------
MONGODB_URI=
COSMOS_DATABASE_NAME=prism

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# API key from Prism Dashboard (Settings → API Keys). Used for tier-based access control.
# Leave empty to run in unauthenticated local-dev mode.
PRISM_API_KEY=
PRISM_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# AI PROVIDERS
# ---------------------------------------------------------------------------
# Provider selection (gemini | azure)
AI_PROVIDER=gemini

# Google Gemini (default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# ADVANCED
# ---------------------------------------------------------------------------
# Enable Cosmos Gremlin graph-based rule ranking boosts (default: false)
USE_GREMLIN_RANKING=false
