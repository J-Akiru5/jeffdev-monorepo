# ============================================
# PRISM MANAGE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values.

# --------------------------------------------
# SUPABASE AUTHENTICATION
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --------------------------------------------
# PUBLIC URLS
# --------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3007"

# --------------------------------------------
# GOOGLE CALENDAR OAUTH
# --------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------
# GITHUB SYNCHRONIZATION
# --------------------------------------------
# GitHub Personal Access Token (with repo / issue scopes)
GITHUB_PAT="ghp_xxxx"
# Marketing repository configuration for issue tracking
GITHUB_MARKETING_REPO_OWNER="your-github-username-or-org"
GITHUB_MARKETING_REPO_NAME="your-repo-name"

# Optional: client-side equivalents if needed for display in UI
NEXT_PUBLIC_GITHUB_MARKETING_REPO_OWNER="your-github-username-or-org"
NEXT_PUBLIC_GITHUB_MARKETING_REPO_NAME="your-repo-name"

# --------------------------------------------
# SLACK NOTIFICATIONS (optional)
# --------------------------------------------
# Incoming webhook URL — task assignments, comments, mentions post here
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# --------------------------------------------
# CRON
# --------------------------------------------
# Vercel cron auth for /api/calendar/sync (GET)
CRON_SECRET="generate-a-random-string"

# --------------------------------------------
# COMPANY BRAIN (optional)
# --------------------------------------------
# Opt-in: auto-distill task comment threads into memory entries on comment.
BRAIN_AUTO_DISTILL="0"
# Shared secret for POST /api/brain/ingest (agent sessions, opencode hook).
# Leave unset to disable the endpoint (it fails closed).
BRAIN_INGEST_SECRET="generate-a-random-string"

# --------------------------------------------
# E2E TESTS (Playwright)
# --------------------------------------------
# Optional overrides — defaults are used when unset (see e2e/global-setup.ts)
E2E_TEST_EMAIL="e2e-test@manage.syntaxure.dev"
E2E_TEST_PASSWORD="E2e-Password-2026!"

# --------------------------------------------
# GENERAL / ANALYTICS
# --------------------------------------------
NODE_ENV="development"
ANALYZE="false"

# --------------------------------------------
# RATE LIMITING (Upstash Redis)
# --------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
