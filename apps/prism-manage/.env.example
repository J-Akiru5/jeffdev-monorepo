# ============================================
# PRISM MANAGE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values.

# --------------------------------------------
# SUPABASE AUTHENTICATION
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --------------------------------------------
# PUBLIC URLS
# --------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3007"

# --------------------------------------------
# GOOGLE CALENDAR OAUTH
# --------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------
# GITHUB SYNCHRONIZATION
# --------------------------------------------
# GitHub Personal Access Token (with repo / issue scopes)
GITHUB_PAT="ghp_xxxx"
# Marketing repository configuration for issue tracking
GITHUB_MARKETING_REPO_OWNER="your-github-username-or-org"
GITHUB_MARKETING_REPO_NAME="your-repo-name"

# Optional: client-side equivalents if needed for display in UI
NEXT_PUBLIC_GITHUB_MARKETING_REPO_OWNER="your-github-username-or-org"
NEXT_PUBLIC_GITHUB_MARKETING_REPO_NAME="your-repo-name"

# --------------------------------------------
# GENERAL / ANALYTICS
# --------------------------------------------
NODE_ENV="development"
ANALYZE="false"
