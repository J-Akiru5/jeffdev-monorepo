{
  "name": "prism-engine",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:local": "node ../../scripts/with-memory-limit.js next dev --port 3001",
    "dev:doppler": "doppler run -- next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "check-types": "node ../../scripts/with-memory-limit.js tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:keandrew": "dotenv -e .env.local -- tsx scripts/seed-keandrew.ts",
    "seed:founder": "dotenv -e .env.local -- tsx scripts/seed-founder.ts"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@google/generative-ai": "^0.24.1",
    "@next/bundle-analyzer": "16.1.4",
    "@syntaxure/ui": "workspace:*",
    "@syntaxure-labs/db": "workspace:*",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.47.0",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^1.17.0",
    "mongodb": "^7.2.0",
    "resend": "^6.12.4",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "vitest": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
