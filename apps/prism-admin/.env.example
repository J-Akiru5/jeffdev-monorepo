# ============================================
# PRISM ADMIN - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values.

# --------------------------------------------
# SUPABASE AUTHENTICATION
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --------------------------------------------
# COSMOS DB / MONGODB
# --------------------------------------------
MONGODB_URI="mongodb+srv://user:password@cluster.mongocluster.cosmos.azure.com/?tls=true"
COSMOS_DATABASE_NAME="prism"

# --------------------------------------------
# RESEND (Email Sending)
# --------------------------------------------
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"

# --------------------------------------------
# PAYPAL SUBSCRIPTIONS
# --------------------------------------------
PAYPAL_WEBHOOK_ID="your-webhook-id"
PAYPAL_CLIENT_ID="your-client-id"
PAYPAL_CLIENT_SECRET="your-client-secret"
PAYPAL_PLAN_TEAM_MONTHLY="P-xxxx"
PAYPAL_PLAN_TEAM_ANNUAL="P-xxxx"

# --------------------------------------------
# PUBLIC URLS
# --------------------------------------------
NEXT_PUBLIC_APP_URL="https://prism-admin.yourdomain.com"
NEXT_PUBLIC_PRISM_URL="https://prism.yourdomain.com"
NEXT_PUBLIC_AGENCY_URL="https://yourdomain.com"
NEXT_PUBLIC_ADMIN_URL="https://prism-admin.yourdomain.com"

# --------------------------------------------
# GENERAL
# --------------------------------------------
NODE_ENV="production"

# --------------------------------------------
# RATE LIMITING (Upstash Redis)
# --------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------
# AI ASSISTANT (optional)
# --------------------------------------------
# If unset, /api/assistant returns 503 (assistant disabled).
GOOGLE_GEMINI_API_KEY=

# --------------------------------------------
# MONITORING (optional)
# --------------------------------------------
# Health-check target for the admin system-status panel.
# Defaults to https://prism.syntaxure.dev/api/health
ENGINE_HEALTH_URL=

# --------------------------------------------
# DEVELOPMENT-ONLY GATES (fail closed everywhere else)
# --------------------------------------------
# /api/bootstrap grants the caller the founder role. Requires BOTH
# NODE_ENV=development AND this flag set to "true".
ADMIN_BOOTSTRAP_ENABLED=false

# /api/auth/bridge/* share Supabase sessions between apps in dev.
# Requires BOTH NODE_ENV=development AND this flag set to "true".
AUTH_BRIDGE_ENABLED=false
