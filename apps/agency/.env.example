# Environment Variables Template
# Copy this to .env.local and fill in your actual values

# ============================================================================
# FIREBASE (CLIENT SDK)
# ============================================================================
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jeffdev-agency.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jeffdev-agency
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jeffdev-agency.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================================================
# FIREBASE (ADMIN SDK - SERVER ONLY)
# ============================================================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Click "Generate new private key" and copy the values
FIREBASE_ADMIN_PROJECT_ID=jeffdev-agency
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jeffdev-agency.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# ============================================================================
# RESEND (EMAIL)
# ============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses (must be verified in Resend)
CONTACT_EMAIL=contact@jeffdev.studio
HIRE_EMAIL=hire@jeffdev.studio
NOREPLY_EMAIL=noreply@jeffdev.studio

# ============================================================================
# CLOUDFLARE R2 (STORAGE - OPTIONAL)
# ============================================================================
# Only needed if you add file uploads later
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=jeffdev-agency
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ============================================================================
# ADMIN (SESSION)
# ============================================================================
# Generate a random string for session encryption
# Example: openssl rand -base64 32
SESSION_SECRET=your_random_secret_here_change_this_in_production

# ============================================================================
# PAYPAL (PAYMENTS)
# ============================================================================
# Get from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # 'sandbox' for testing, 'live' for production
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# ============================================================================
# GCASH (PAYMENTS - PHILIPPINES)
# ============================================================================
NEXT_PUBLIC_GCASH_NUMBER=09XXXXXXXXX

# ============================================================================
# PUBLIC URL
# ============================================================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
