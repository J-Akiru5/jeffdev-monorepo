# Environment Variables for Prism Dashboard
# Copy to .env.local and fill in actual values

# ============================================================================
# CLERK (AUTH)
# ============================================================================
# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ============================================================================
# GOOGLE GEMINI (AI)
# ============================================================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ============================================================================
# AZURE COSMOS DB (DATABASE)
# ============================================================================
# Get from: Azure Portal > Cosmos DB > Connection strings
COSMOS_CONNECTION_STRING=mongodb://your-cosmos-account:password@your-cosmos-account.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@your-cosmos-account@
COSMOS_DATABASE_NAME=prism

# ============================================================================
# PAYPAL (SUBSCRIPTIONS)
# ============================================================================
# Get from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# PayPal Subscription Plan IDs (create in PayPal dashboard)
PAYPAL_PLAN_PRO=P-xxxxx
PAYPAL_PLAN_TEAM=P-xxxxx
PAYPAL_PLAN_ENTERPRISE=P-xxxxx

# ============================================================================
# MUX (VIDEO CONTEXT)
# ============================================================================
# Get from: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
# Webhook signing secret (optional but recommended for production)
MUX_WEBHOOK_SECRET=your_mux_webhook_secret

# ============================================================================
# PUBLIC
# ============================================================================
# App URLs
NEXT_PUBLIC_PRISM_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

