{
  "name": "jeffdev-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=prism-admin",
    "build:engine": "turbo run build --filter=prism-engine",
    "build:labs": "turbo run build --filter=syntaxure-labs",
    "build:manage": "turbo run build --filter=prism-manage",
    "build:docs": "turbo run build --filter=prism-docs",
    "dev": "turbo run dev --filter=syntaxure-labs...",
    "dev:admin": "turbo run dev --filter=prism-admin...",
    "dev:engine": "turbo run dev --filter=prism-engine...",
    "dev:labs": "turbo run dev --filter=syntaxure-labs...",
    "dev:manage": "turbo run dev --filter=prism-manage...",
    "dev:docs": "turbo run dev --filter=prism-docs...",
    "dev:all": "turbo run dev --concurrency=2",
    "dev:local": "node scripts/with-memory-limit.js turbo dev --filter=syntaxure-labs...",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "test": "turbo run test",
    "clean": "node scripts/clean.js",
    "changeset": "changeset",
    "prepare": "husky",
    "prisma:generate": "pnpm --filter @syntaxure-labs/db run prisma:generate",
    "prisma:studio": "pnpm --filter @syntaxure-labs/db run prisma:studio",
    "prisma:pull": "pnpm --filter @syntaxure-labs/db run prisma:pull",
    "prisma:migrate": "pnpm --filter @syntaxure-labs/db run prisma:migrate",
    "prisma:deploy": "pnpm --filter @syntaxure-labs/db run prisma:deploy"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@next/bundle-analyzer": "^15.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "supabase": "^2.101.0",
    "syncpack": "^13.0.4",
    "turbo": "^2.9.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@novu/node": "^2.6.6",
    "@paypal/react-paypal-js": "^8.9.2",
    "ai": "^6.0.5",
    "zustand": "^5.0.9"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "version": "3.0.0"
}
