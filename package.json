{
  "name": "jeffdev-monorepo",
  "private": true,
  "scripts": {
    "build": "doppler run -- turbo build",
    "dev": "doppler run -- turbo dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "syncpack": "^13.0.4",
    "turbo": "^2.7.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@novu/node": "^2.6.6",
    "@paypal/react-paypal-js": "^8.9.2",
    "@upstash/ratelimit": "^2.0.7",
    "ai": "^6.0.5",
    "zustand": "^5.0.9"
  },
  "version": "1.0.0"
}
