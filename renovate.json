{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
  ],
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "separateMinorPatch": true,
  "minimumReleaseAge": "3 days",
  "pnpm": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "Ignore internal workspace packages — never auto-update these",
      "matchPackagePrefixes": ["@repo/", "@syntaxure"],
      "enabled": false
    },
    {
      "description": "Group Supabase ecosystem (supabase-js + ssr)",
      "matchPackagePrefixes": ["@supabase/"],
      "groupName": "Supabase",
      "groupSlug": "supabase",
      "automerge": false
    },
    {
      "description": "Group Next.js core packages",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "Next.js",
      "groupSlug": "nextjs",
      "automerge": false
    },
    {
      "description": "Group Tailwind CSS packages",
      "matchPackagePrefixes": ["@tailwindcss/"],
      "matchPackageNames": ["tailwindcss"],
      "groupName": "Tailwind CSS",
      "groupSlug": "tailwindcss"
    },
    {
      "description": "Group Changesets packages",
      "matchPackagePrefixes": ["@changesets/"],
      "groupName": "Changesets",
      "groupSlug": "changesets"
    },
    {
      "description": "Group FullCalendar packages",
      "matchPackagePrefixes": ["@fullcalendar/"],
      "groupName": "FullCalendar",
      "groupSlug": "fullcalendar"
    },
    {
      "description": "Group TypeScript-related packages (typescript, @types/*)",
      "matchPackagePrefixes": ["@types/"],
      "matchPackageNames": ["typescript"],
      "groupName": "TypeScript types",
      "groupSlug": "typescript-types",
      "automerge": true
    },
    {
      "description": "Auto-merge safe patch updates if CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Auto-merge minor updates for devDependencies (lower risk)",
      "matchUpdateTypes": ["minor"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Flag any package moving to a new major version — needs manual review",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "automerge": false
    }
  ]
}
