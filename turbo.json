{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PRISM_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_AGENCY_URL",
    "MONGODB_URI",
    "COSMOS_CONNECTION_STRING",
    "COSMOS_DATABASE_NAME",
    "GEMINI_API_KEY",
    "GOOGLE_GEMINI_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "AZURE_OPENAI_ENDPOINT",
    "AZURE_OPENAI_API_KEY",
    "AZURE_OPENAI_DEPLOYMENT_NAME",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "PAYPAL_MODE",
    "PAYPAL_PLAN_*",
    "PAYPAL_API_URL",
    "NEXT_PUBLIC_PAYPAL_CLIENT_ID",
    "NEXT_PUBLIC_FIREBASE_*",
    "FIREBASE_*",
    "R2_*",
    "DOPPLER_*",
    "ZOHO_*",
    "RESEND_*",
    "ADMIN_EMAIL",
    "SENTRY_*",
    "NEXT_PUBLIC_SENTRY_*",
    "AGENCY_FIREBASE_KEY",
    "EXCHANGE_RATE_API_KEY",
    "EXCHANGE_RATE_API_KEY_",
    "GA_PROPERTY_ID",
    "CONTACT_EMAIL",
    "HIRE_EMAIL",
    "NOREPLY_EMAIL",
    "SESSION_SECRET",
    "PRISM_API_KEY",
    "PRISM_API_URL",
    "AI_PROVIDER",
    "DEEPSEEK_ENDPOINT",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_MODEL_NAME",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT",
    "GEMINI_MODEL",
    "GEMINI_EMBEDDING_MODEL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_SERVICE_ROLE_KEY_",
    "SUPABASE_URL",
    "SUPABASE_PROJECT_ID",
    "SUPABASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_ANON_KEY",
    "RESEND_API_KEY_",
    "ANALYZE",
    "COSMOS_GREMLIN_ENDPOINT",
    "COSMOS_GREMLIN_KEY",
    "USE_GREMLIN_RANKING",
    "N8N_WEBHOOK_URL",
    "PAYPAL_WEBHOOK_ID",
    "NODE_ENV",
    "NEXT_RUNTIME",
    "CI",
    "GITHUB_PAT",
    "GITHUB_MARKETING_REPO_OWNER",
    "GITHUB_MARKETING_REPO_NAME",
    "PRISM_TOKEN",
    "FOUNDER_UID",
    "FEATURE_PRISM_ENGINE_ENABLED",
    "FEATURE_PRISM_ENGINE_TEASER",
    "SUPPORT_EMAIL",
    "VERCEL_ENV",
    "BASE_URL",
    "npm_package_version",
    "DATABASE_PASSWORD",
    "NPM_TOKEN",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next/standalone/**",
        "dist/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["NODE_OPTIONS"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.test.ts", "src/**/*.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
