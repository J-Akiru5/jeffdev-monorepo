{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PRISM_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "MONGODB_URI",
    "COSMOS_CONNECTION_STRING",
    "COSMOS_DATABASE_NAME",
    "GEMINI_API_KEY",
    "AZURE_OPENAI_ENDPOINT",
    "AZURE_OPENAI_API_KEY",
    "AZURE_OPENAI_DEPLOYMENT_NAME",
    "MUX_TOKEN_ID",
    "MUX_TOKEN_SECRET",
    "MUX_WEBHOOK_SECRET",
    "PAYPAL_CLIENT_ID",
    "PAYPAL_CLIENT_SECRET",
    "PAYPAL_MODE",
    "PAYPAL_PLAN_*",
    "PAYPAL_API_URL",
    "NEXT_PUBLIC_PAYPAL_CLIENT_ID",
    "NEXT_PUBLIC_FIREBASE_*",
    "FIREBASE_*",
    "R2_*",
    "DOPPLER_*",
    "ZOHO_*",
    "RESEND_*",
    "ADMIN_EMAIL",
    "SENTRY_*",
    "NEXT_PUBLIC_SENTRY_*",
    "AGENCY_FIREBASE_KEY",
    "EXCHANGE_RATE_API_KEY",
    "GA_PROPERTY_ID",
    "CONTACT_EMAIL",
    "HIRE_EMAIL",
    "NOREPLY_EMAIL",
    "SESSION_SECRET",
    "PRISM_API_KEY",
    "PRISM_API_URL",
    "AI_PROVIDER",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT",
    "GEMINI_MODEL",
    "GEMINI_EMBEDDING_MODEL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "COSMOS_GREMLIN_ENDPOINT",
    "COSMOS_GREMLIN_KEY",
    "ANALYZE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".next/standalone/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.test.ts", "src/**/*.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
